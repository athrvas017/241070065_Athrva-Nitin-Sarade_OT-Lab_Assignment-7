diff --git a/kernel/proc.h b/kernel/proc.h
--- a/kernel/proc.h
+++ b/kernel/proc.h
@@ -87,6 +87,8 @@ struct proc {
   int killed;                  // If non-zero, have been killed
   int xstate;                  // Exit status to be returned to parent's wait
   int pid;                     // Process ID
+  int priority;                // Process scheduling priority (0=highest, 31=lowest)
+  int ticks_accumulated;       // Runtime accounting ticks
 
   // wait_lock must be held when using this:
   struct proc *parent;         // Parent process
diff --git a/kernel/proc.c b/kernel/proc.c
--- a/kernel/proc.c
+++ b/kernel/proc.c
@@ -124,6 +124,8 @@ allocproc(void)
   p->state = USED;
+  p->priority = 15;            // Default medium priority
+  p->ticks_accumulated = 0;
 
   // Allocate a trapframe page.
   if((p->trapframe = (struct trapframe *)kalloc()) == 0){
@@ -445,6 +447,7 @@ scheduler(void)
   struct cpu *c = mycpu();
   c->proc = 0;
   for(;;){
+    struct proc *highest_p = 0;
     // Avoid deadlock by ensuring that devices can interrupt.
     intr_on();
 
@@ -452,19 +455,27 @@ scheduler(void)
       acquire(&p->lock);
-      if(p->state == RUNNABLE) {
-        // Switch to chosen process.  It is the process's job
-        // to release its lock and then reacquire it
-        // before jumping back to us.
-        p->state = RUNNING;
-        c->proc = p;
-        swtch(&c->context, &p->context);
-
-        // Process is done running for now.
-        // It should have changed its p->state before coming back.
-        c->proc = 0;
-      }
-      release(&p->lock);
+      if(p->state == RUNNABLE) {
+        if(highest_p == 0 || p->priority < highest_p->priority) {
+          if(highest_p)
+            release(&highest_p->lock);
+          highest_p = p;
+          continue; // keep lock held on current candidate
+        }
+      }
+      release(&p->lock);
+    }
+
+    if(highest_p) {
+      highest_p->state = RUNNING;
+      highest_p->ticks_accumulated++;
+      c->proc = highest_p;
+      swtch(&c->context, &highest_p->context);
+      c->proc = 0;
+      release(&highest_p->lock);
     }
   }
 }
diff --git a/kernel/sysproc.c b/kernel/sysproc.c
--- a/kernel/sysproc.c
+++ b/kernel/sysproc.c
@@ -95,3 +95,14 @@ sys_uptime(void)
   release(&tickslock);
   return xticks;
 }
+
+uint64
+sys_setpriority(void)
+{
+  int priority;
+  argint(0, &priority);
+  if(priority < 0 || priority > 31)
+    return -1;
+  myproc()->priority = priority;
+  return 0;
+}
